      "category": "architecture",
      "fixtureId": "sample-csharp-api",
      "fixtureVersion": "v1",
      "question": "What is the architecture of this project?",
      "answerable": true,
      "expectedBehavior": "answer-with-evidence",
      "expectedEvidenceFiles": [ "Program.cs", "WeatherController.cs", "WeatherService.cs", "IWeatherService.cs" ],
      "expectedEvidenceSnippets": [ "AddScoped<IWeatherService, WeatherService>", "class WeatherController", "class WeatherService", "interface IWeatherService" ],
      "expectedEvidenceKeys": [ "class:WeatherController", "class:WeatherService", "interface:IWeatherService", "class:WeatherDbContext" ],
      "expectedConcepts": [ "Controller", "Service", "Interface", "Dependency Injection", "ASP.NET Core API" ],
      "expectedFacts": [
        "WeatherController depends on IWeatherService",
        "WeatherService implements IWeatherService",
        "Program.cs registers IWeatherService to WeatherService via AddScoped"
      ],
      "answerCharacteristics": [
        "Names WeatherController, WeatherService and IWeatherService",
        "Mentions constructor/DI registration as the wiring mechanism",
        "Cites Program.cs / WeatherController.cs / WeatherService.cs evidence",
        "Does not claim Clean Architecture layers beyond fixture evidence"
      ]
    },
